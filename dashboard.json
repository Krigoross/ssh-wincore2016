let duree = 2d;
EmailAttachmentInfo
| where Timestamp > ago(duree)
| extend
    EstEML = FileName endswith ".eml"
        or FileType in~ ("eml", "message/rfc822"),
    EstATT = FileName =~ "ATT00004"
| summarize
    NombreEML = countif(EstEML),
    NombreATT = countif(EstATT),
    Pieces_jointes_EML = make_set_if(FileName, EstEML),
    Pieces_jointes_ATT = make_set_if(FileName, EstATT),
    Types_ATT = make_set_if(FileType, EstATT),
    Hash_EML = make_set_if(SHA256, EstEML),
    Hash_ATT = make_set_if(SHA256, EstATT)
    by NetworkMessageId, RecipientEmailAddress
| where NombreEML > 0 and NombreATT > 0
| join kind=leftouter (
    EmailEvents
    | where Timestamp > ago(duree)
    | summarize arg_max(Timestamp, *)
        by NetworkMessageId, RecipientEmailAddress
) on NetworkMessageId, RecipientEmailAddress
| project
    Timestamp,
    Subject,
    RecipientEmailAddress,
    Sender = SenderMailFromAddress,
    Pieces_jointes_EML,
    Pieces_jointes_ATT,
    Types_ATT,
    DeliveryLocation,
    DeliveryAction,
    LatestDeliveryLocation,
    ThreatTypes,
    DetectionMethods,
    SenderIPv4,
    SenderIPv6,
    Hash_EML,
    Hash_ATT,
    NetworkMessageId
| order by Timestamp desc