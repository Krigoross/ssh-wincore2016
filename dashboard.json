let duree = 2d;
EmailAttachmentInfo
| where Timestamp > ago(duree)
| extend
    EstEML = FileName endswith ".eml"
        or FileType in~ ("eml", "message/rfc822"),
    EstJPEG = FileType in~ ("jpeg", "jpg", "image/jpeg", "image/jpg")
        and FileName =~ "ATT00004"
| summarize
    NombreEML = countif(EstEML),
    NombreJPEG = countif(EstJPEG),
    Pieces_jointes_EML = make_set_if(FileName, EstEML),
    Pieces_jointes_JPEG = make_set_if(FileName, EstJPEG),
    Hash_EML = make_set_if(SHA256, EstEML),
    Hash_JPEG = make_set_if(SHA256, EstJPEG)
    by NetworkMessageId, RecipientEmailAddress
| where NombreEML > 0 and NombreJPEG > 0
| join kind=leftouter (
    EmailEvents
    | where Timestamp > ago(duree)
    | summarize arg_max(Timestamp, *)
        by NetworkMessageId, RecipientEmailAddress
) on NetworkMessageId, RecipientEmailAddress
| project
    Timestamp,
    Subject,
    RecipientEmailAddress,
    Sender = SenderMailFromAddress,
    Pieces_jointes_EML,
    Pieces_jointes_JPEG,
    DeliveryLocation,
    DeliveryAction,
    LatestDeliveryLocation,
    ThreatTypes,
    DetectionMethods,
    SenderIPv4,
    SenderIPv6,
    Hash_EML,
    Hash_JPEG,
    NetworkMessageId
| order by Timestamp desc