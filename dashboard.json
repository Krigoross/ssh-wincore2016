{
    "visualizations": {
        "viz_finding_table": {
            "type": "splunk.table",
            "title": "1. Détails du Finding (Événement Notable)",
            "dataSources": {
                "primary": "ds_finding_details"
            },
            "options": {
                "count": 5,
                "rowNumbers": false
            }
        },
        "viz_user_timeline": {
            "type": "splunk.column",
            "title": "2. Timeline des activités de l'utilisateur suspect (Évolution par SourceType)",
            "dataSources": {
                "primary": "ds_user_activity"
            },
            "options": {
                "stackMode": "stacked"
            }
        },
        "viz_network_traffic": {
            "type": "splunk.table",
            "title": "3. Trafic Réseau de la machine (Recherche de C2 / Mouvement Latéral)",
            "dataSources": {
                "primary": "ds_network_traffic"
            },
            "options": {
                "count": 10
            }
        },
        "viz_process_exec": {
            "type": "splunk.table",
            "title": "4. Exécutions de Processus (Host / Endpoint)",
            "dataSources": {
                "primary": "ds_process_exec"
            }
        }
    },
    "dataSources": {
        "ds_finding_details": {
            "type": "ds.search",
            "options": {
                "query": "index=notable OR index=risk event_id=\"*$finding_tok$*\" \n| table _time, rule_name, risk_object, risk_object_type, user, dest, severity, description \n| sort - _time",
                "queryParameters": {
                    "earliest": "$global_time.earliest$",
                    "latest": "$global_time.latest$"
                }
            },
            "name": "Recherche Détails Finding"
        },
        "ds_user_activity": {
            "type": "ds.search",
            "options": {
                "query": "index=* user=\"*$user_tok$*\" user!=\"\" \n| timechart count by sourcetype",
                "queryParameters": {
                    "earliest": "$global_time.earliest$",
                    "latest": "$global_time.latest$"
                }
            },
            "name": "Recherche Activité Utilisateur"
        },
        "ds_network_traffic": {
            "type": "ds.search",
            "options": {
                "query": "index=* (src=\"*$dest_tok$*\" OR dest=\"*$dest_tok$*\") action!=blocked dest_port!=\"\" \n| stats count, values(dest_port) as ports by src, dest, action \n| sort - count",
                "queryParameters": {
                    "earliest": "$global_time.earliest$",
                    "latest": "$global_time.latest$"
                }
            },
            "name": "Recherche Trafic Réseau"
        },
        "ds_process_exec": {
            "type": "ds.search",
            "options": {
                "query": "index=* dest=\"*$dest_tok$*\" (sourcetype=WinEventLog:Security EventCode=4688) OR (sourcetype=\"XmlWinEventLog:Microsoft-Windows-Sysmon/Operational\" EventCode=1) \n| stats count, values(CommandLine) as CommandLine by _time, Creator_Process_Name, New_Process_Name \n| sort - _time",
                "queryParameters": {
                    "earliest": "$global_time.earliest$",
                    "latest": "$global_time.latest$"
                }
            },
            "name": "Recherche Processus"
        }
    },
    "inputs": {
        "input_global_time": {
            "type": "input.timerange",
            "options": {
                "token": "global_time",
                "defaultValue": "-24h@h,now"
            },
            "title": "Période d'investigation"
        },
        "input_finding_id": {
            "type": "input.text",
            "options": {
                "token": "finding_tok",
                "defaultValue": "*"
            },
            "title": "ID du Finding (event_id)"
        },
        "input_user": {
            "type": "input.text",
            "options": {
                "token": "user_tok",
                "defaultValue": "*"
            },
            "title": "Utilisateur cible (user)"
        },
        "input_dest": {
            "type": "input.text",
            "options": {
                "token": "dest_tok",
                "defaultValue": "*"
            },
            "title": "Machine / IP cible (dest)"
        }
    },
    "layout": {
        "type": "absolute",
        "options": {
            "display": "auto-scale"
        },
        "structure": [
            {
                "item": "viz_finding_table",
                "type": "block",
                "x": 20,
                "y": 20,
                "w": 1400,
                "h": 200
            },
            {
                "item": "viz_user_timeline",
                "type": "block",
                "x": 20,
                "y": 240,
                "w": 690,
                "h": 300
            },
            {
                "item": "viz_network_traffic",
                "type": "block",
                "x": 730,
                "y": 240,
                "w": 690,
                "h": 300
            },
            {
                "item": "viz_process_exec",
                "type": "block",
                "x": 20,
                "y": 560,
                "w": 1400,
                "h": 350
            }
        ],
        "globalInputs": [
            "input_global_time",
            "input_finding_id",
            "input_user",
            "input_dest"
        ]
    },
    "title": "Investigation SOC - Analyse de Finding & Comportements Suspects",
    "description": "Dashboard pour pivoter rapidement depuis un Finding vers l'analyse du poste de travail, de l'utilisateur et du réseau. Remplissez les champs ci-dessus pour filtrer."
}
