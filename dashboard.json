let Target = "utilisateur@entreprise.fr";
let Lookback = 14d;

// Ignore casse, chiffres, ponctuation et espaces.
// Exemple : Facture_2026-123.pdf -> facturepdf
let Normalize = (s:string) {
    replace_regex(tolower(s), @"[\W_0-9]+", "")
};

let Reported = (
    AlertEvidence
    | where Timestamp > ago(Lookback)
    | where Title =~ "Email reported by user as malware or phish"
    | where isnotempty(NetworkMessageId)
    | distinct NetworkMessageId
);

let Mail = materialize(
    EmailEvents
    | where Timestamp > ago(Lookback)
    | summarize arg_max(Timestamp, *)
        by NetworkMessageId, RecipientEmailAddress
    | project Timestamp, NetworkMessageId, RecipientEmailAddress,
              Subject, SenderFromAddress, EmailClusterId,
              DeliveryAction, DeliveryLocation, LatestDeliveryLocation
);

let Seeds = materialize(
    Mail
    | where DeliveryLocation == "Quarantine"
        or NetworkMessageId in (Reported)
    | extend SeedReason = iff(
        NetworkMessageId in (Reported),
        "Signalement utilisateur",
        "Quarantaine à la livraison")
    | project SeedId = NetworkMessageId,
              SeedRecipient = RecipientEmailAddress,
              SeedSubject = Subject, SeedReason
);

let Targets = materialize(
    Mail
    | where RecipientEmailAddress =~ Target
    | where DeliveryAction in ("Delivered", "Junked")
);

let RelevantIds = (
    union
        (Seeds | project NetworkMessageId = SeedId),
        (Targets | project NetworkMessageId)
    | distinct NetworkMessageId
);

// Une clé par critère de rapprochement.
let Keys = materialize(
    union
        (
            Mail
            | where NetworkMessageId in (RelevantIds)
            | where isnotnull(EmailClusterId) and EmailClusterId != 0
            | project NetworkMessageId,
                      MatchType = "Cluster Microsoft",
                      MatchKey = tostring(EmailClusterId)
        ),
        (
            Mail
            | where NetworkMessageId in (RelevantIds)
            | extend MatchKey = Normalize(Subject)
            | where strlen(MatchKey) >= 8
            | project NetworkMessageId,
                      MatchType = "Objet normalisé", MatchKey
        ),
        (
            EmailAttachmentInfo
            | where Timestamp > ago(Lookback)
            | where NetworkMessageId in (RelevantIds)
            | extend MatchKey = Normalize(FileName)
            | where strlen(MatchKey) >= 8
            | project NetworkMessageId,
                      MatchType = "Nom PJ normalisé", MatchKey
        ),
        (
            EmailUrlInfo
            | where Timestamp > ago(Lookback)
            | where NetworkMessageId in (RelevantIds)
            | extend MatchKey = tolower(UrlDomain)
            | where isnotempty(MatchKey)
            | project NetworkMessageId,
                      MatchType = "Domaine URL", MatchKey
        )
    | distinct NetworkMessageId, MatchType, MatchKey
);

let SeedKeys = (
    Keys
    | join kind=inner Seeds
        on $left.NetworkMessageId == $right.SeedId
    | project MatchType, MatchKey,
              SeedId, SeedRecipient, SeedSubject, SeedReason
);

Targets
| join kind=inner Keys on NetworkMessageId
| join kind=inner SeedKeys on MatchType, MatchKey
// Évite de comparer la même copie à elle-même.
| where NetworkMessageId != SeedId
    or RecipientEmailAddress !~ SeedRecipient
| summarize
    MatchTypes = make_set(MatchType),
    MatchedValues = make_set(MatchKey)
    by Timestamp, NetworkMessageId, RecipientEmailAddress,
       Subject, SenderFromAddress, LatestDeliveryLocation,
       SeedId, SeedRecipient, SeedSubject, SeedReason
| extend MatchingCriteria = array_length(MatchTypes)
| order by MatchingCriteria desc, Timestamp desc